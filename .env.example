# Copy to .env.local and fill in. Never commit .env.local.
# https://console.x.ai/ → API key
XAI_API_KEY=
# optional override (default: grok-4-1-fast-non-reasoning)
# XAI_MODEL=grok-4.5

# --- paths (optional; defaults are inside the repo) ---
# Live board file (sync this across PC/laptop via Syncthing)
# ROUTINE_DATA=C:/Users/you/Sync/pid/board.json
# Clean markdown vault (default: ./vault) — not the old Obsidian vault
# ROUTINE_VAULT=C:/Users/you/Sync/pid/vault

# --- Google Calendar auto-sync (optional) ---
# Cloud Console → APIs → enable Google Calendar API
# Credentials → OAuth client → Desktop or Web
# Authorized redirect: http://127.0.0.1:4000/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/google/callback
