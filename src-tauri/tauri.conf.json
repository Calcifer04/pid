{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "piD",
  "version": "0.1.0",
  "identifier": "local.pid.board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4000",
    "beforeBuildCommand": "npm run build && npm run build:server",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "πD",
        "width": 1120,
        "height": 780,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://127.0.0.1:4000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": ["../dist-server/pid-server.mjs"],
    "longDescription": "πD personal board — today, week, calendar, SOPs, Grok assist.",
    "shortDescription": "πD personal board",
    "category": "Productivity",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
