{
  "name": "pid",
  "private": true,
  "version": "0.1.0",
  "description": "piD local board (today/week/SOPs/calendar). Lightweight local web app.",
  "type": "module",
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "dev": "vite",
    "dev:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-bg.ps1",
    "dev:unix": "bash ./scripts/dev.sh",
    "build": "tsc --noEmit && vite build",
    "build:server": "node ./scripts/build-server.js",
    "build:app": "node ./scripts/build-app.js",
    "preview": "vite preview --host 0.0.0.0 --port 4000 --strictPort",
    "start": "node ./scripts/run-server.js",
    "start:vite": "vite preview --host 0.0.0.0 --port 4000 --strictPort",
    "start:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-bg.ps1",
    "start:unix": "bash ./scripts/start.sh",
    "open": "node ./scripts/open.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node ./scripts/build-app.js",
    "install:app": "node ./scripts/install-app.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
